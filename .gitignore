# 内核二进制 —— Actions 每次自己下载，不要提交（54MB，而且 mac/linux 不通用）
bin/*
!bin/.gitkeep

# 临时文件
__pycache__/
*.pyc
data/generated.yaml
logs/

# 上一轮快照（保留节点列表和历史池就够了）
data/nodes.prev.json
out/nodes_best.prev.json

# 本地 SSH 密钥(仅用于推送，绝不提交)
.ssh/

# 内核探测的临时工作目录/缓存, 不进库
data/kernel_cache/
out.bak.*
data/nodes.prev-run.json
data/nodes_fresh*.json

# 自建节点的凭据(UUID/path), 等于密码, 绝不进库
data/cf_self.json
data/cf_ips.json
logs/cf_scan.log

# 自建订阅产物含 UUID, 不进库
out/sub_self*
out/cf_relay.yaml
